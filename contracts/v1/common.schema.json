{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.voipappz.io/builder/v1/common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "checkpointId": {
      "type": "string",
      "pattern": "^chk_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "actorId": {
      "description": "Platform user or account UUID of the caller.",
      "$ref": "#/$defs/uuid"
    },
    "revision": {
      "description": "Exact source revision: a git commit id (SHA-1 or SHA-256).",
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "validationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "status",
        "checkedAt"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "summary": {
          "type": "string",
          "maxLength": 4000
        },
        "checkedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
