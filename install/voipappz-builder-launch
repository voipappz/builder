#!/usr/bin/env bash
# Start, stop or inspect VoipAppz Builder for this user.
#
#   voipappz-builder-launch [start]   start (or reopen) Builder and open the browser
#   voipappz-builder-launch stop      stop Builder, its agent and the dev server it started
#   voipappz-builder-launch status
#   voipappz-builder-launch logs
#
# Settings come from ~/.config/voipappz-builder/builder.env, written by
# install/install.sh.
set -euo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/voipappz-builder/builder.env"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/voipappz-builder"
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

[ -f "$CONFIG" ] || { echo "Not installed: $CONFIG is missing (run install/install.sh)" >&2; exit 1; }
# shellcheck source=/dev/null
. "$CONFIG"
PORT="${PORT:-9832}"
mkdir -p "$STATE"
chmod 700 "$STATE"

URL_FILE="$STATE/url"
PID_FILE="$STATE/builder.pid"
LOG="$STATE/builder.log"

notify() {
  echo "$1"
  command -v notify-send >/dev/null 2>&1 && notify-send "VoipAppz Builder" "$1" || true
}

running() { [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; }

start() {
  if running && [ -f "$URL_FILE" ]; then
    xdg-open "$(cat "$URL_FILE")" >/dev/null 2>&1 &
    echo "Builder is already running; opened it again."
    return
  fi
  local args=(--app-repo "$APP_REPO" --client-url "$CLIENT_URL" --port "$PORT"
              --url-file "$URL_FILE" --open)
  [ "${START_APP:-1}" = "1" ] && args+=(--start-app)
  [ -n "${API_DIR:-}" ] && args+=(--api-dir "$API_DIR")
  [ -n "${API_URL:-}" ] && args+=(--api-url "$API_URL")

  rm -f "$URL_FILE"
  setsid voipappz-builder "${args[@]}" > "$LOG" 2>&1 &
  echo $! > "$PID_FILE"
  # The first start may create a worktree and install packages.
  for _ in $(seq 1 600); do
    [ -f "$URL_FILE" ] && break
    running || break
    sleep 0.5
  done
  if [ -f "$URL_FILE" ]; then
    echo "Builder is running. Logs: $LOG"
  else
    notify "Builder did not start: $(tail -n 3 "$LOG" | tr '\n' ' ')"
    exit 1
  fi
}

stop() {
  if running; then
    kill -TERM "$(cat "$PID_FILE")"
    for _ in $(seq 1 40); do running || break; sleep 0.25; done
    echo "Builder stopped."
  else
    echo "Builder is not running."
  fi
  rm -f "$PID_FILE" "$URL_FILE"
}

status() {
  running && echo "Builder: running (pid $(cat "$PID_FILE"))" || echo "Builder: stopped"
  echo "App repository: $APP_REPO"
  [ -f "$LOG" ] && grep -E "workspace|API tools" "$LOG" | tail -2 | sed 's/^ */  /'
  return 0
}

case "${1:-start}" in
  start) start ;;
  stop) stop ;;
  status) status ;;
  logs) tail -n 40 "$LOG" "$STATE/app.log" 2>/dev/null ;;
  *) echo "usage: $(basename "$0") [start|stop|status|logs]" >&2; exit 2 ;;
esac
